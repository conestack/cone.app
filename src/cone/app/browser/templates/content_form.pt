<div xmlns:tal="http://xml.zope.org/namespaces/tal">

  <tal:contextmenu condition="context.show_contextmenu"
                   replace="structure context.rendered_contextmenu" />

  <div tal:define="css 'card mt-3' if context.is_card else 'mt-3'"
       tal:attributes="class css">

    <h5 tal:condition="context.show_heading"
        tal:attributes="class 'card-header' if context.is_card else 'mb-3'"
        tal:content="context.form_heading">Title</h5>

    <div tal:define="css 'card-body' if context.is_card else ''"
         tal:attributes="class css">
      <div>
        <tal:form replace="structure context.rendered_form" />
      </div>
    </div>

  </div>

</div>
