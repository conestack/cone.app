<tal:block xmlns:tal="http://xml.zope.org/namespaces/tal"
           xmlns:i18n="http://xml.zope.org/namespaces/i18n"
           i18n:domain="cone.app"
           omit-tag="True">

  <div class="card mt-3">
    <h5 class="card-header" i18n:translate="not_found_label">Not Found</h5>
    <div class="card-body">
      <p class="card-text" i18n:translate="not_found_text">
      The requested resource cannot be found.
      </p>
    </div>
  </div>

</tal:block>
