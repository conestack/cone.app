<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">Wiki Container</div>
    <div class="card-body">
      <p class="small">Entry container for wiki pages. Acts as reference browser root.</p>
      <pre class="bg-light p-2 small"><code>@node_info(
    name='wiki',
    addables=['wiki_page'])
class Wiki(BaseContainer):
    ...</code></pre>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">node_info</div>
    <div class="card-body">
      <p class="small">Registers node type with metadata and allowed children.</p>
      <pre class="bg-light p-2 small"><code>@node_info(
    name='wiki',
    title=_('wiki', default='Wiki'),
    icon='bi-book',
    addables=['wiki_page'])</code></pre>
    </div>
  </div>

</tal:view>
