<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3 example-header example-header-wiki">

    <div class="card-body">

      <h4 class="card-title">
        <i class="bi-folder me-2"></i>
        <span class="label label-primary"
              tal:content="model.metadata.title">
          Title
        </span>
      </h4>

      <tal:byline replace="structure tile('byline')" />

      <p class="card-text text-muted"
         tal:condition="model.metadata.description"
         tal:content="model.metadata.description">
        Description
      </p>

      <div class="mt-2">
        <span class="badge example-badge-wiki">Wiki Folder</span>
        <span class="badge example-badge-wiki">Nested Hierarchy</span>
      </div>

    </div>

  </div>

</tal:view>
