<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3 example-header example-header-wiki">

    <div class="card-body">

      <h4 class="card-title">
        <i class="bi-book me-2"></i>
        <span class="label label-primary"
              tal:content="model.metadata.title">
          Title
        </span>
      </h4>

      <tal:byline replace="structure tile('byline')" />

      <p class="card-text text-muted">
        Wiki pages with workflow states, cross-references, categories,
        folders for organization, and protected properties.
      </p>

      <div class="mt-2">
        <span class="badge example-badge-wiki">Workflow</span>
        <span class="badge example-badge-wiki">Folders</span>
        <span class="badge example-badge-wiki">Reference Browser</span>
        <span class="badge example-badge-wiki">Categories</span>
        <span class="badge example-badge-wiki">Protected Properties</span>
      </div>

    </div>

  </div>

</tal:view>
