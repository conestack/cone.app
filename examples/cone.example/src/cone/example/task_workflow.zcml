<configure xmlns="http://namespaces.repoze.org/bfg"
           xmlns:i18n="http://xml.zope.org/namespaces/i18n"
           i18n:domain="cone.example">

  <include package="repoze.workflow" file="meta.zcml"/>

  <workflow type="task_workflow"
            name="Task Workflow"
            state_attr="state"
            initial_state="todo"
            content_types=".project.model.Task"
            permission_checker="cone.app.workflow.permission_checker">

    <state name="todo"
           title="To Do"
           i18n:attributes="name">
      <key name="description"
           value="Task is pending"
           i18n:attributes="value" />
    </state>

    <state name="in_progress"
           title="In Progress"
           i18n:attributes="name">
      <key name="description"
           value="Task is being worked on"
           i18n:attributes="value" />
    </state>

    <state name="done"
           title="Done"
           i18n:attributes="name">
      <key name="description"
           value="Task is completed"
           i18n:attributes="value" />
    </state>

    <state name="closed"
           title="Closed"
           i18n:attributes="name">
      <key name="description"
           value="Task is closed"
           i18n:attributes="value" />
    </state>

    <transition
       name="start"
       title="Start"
       callback="cone.app.workflow.persist_state"
       from_state="todo"
       to_state="in_progress"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="complete"
       title="Complete"
       callback="cone.app.workflow.persist_state"
       from_state="in_progress"
       to_state="done"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="close"
       title="Close"
       callback="cone.app.workflow.persist_state"
       from_state="done"
       to_state="closed"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="reopen"
       title="Reopen"
       callback="cone.app.workflow.persist_state"
       from_state="done"
       to_state="in_progress"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="reset"
       title="Reset"
       callback="cone.app.workflow.persist_state"
       from_state="in_progress"
       to_state="todo"
       permission="change_state"
       i18n:attributes="name"
    />

  </workflow>

</configure>
