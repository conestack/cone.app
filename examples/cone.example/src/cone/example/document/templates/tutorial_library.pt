<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">BaseContainer</div>
    <div class="card-body">
      <p class="small">File-based storage container. Children persisted to disk.</p>
      <pre class="p-2 small"><code>class DocumentLibrary(BaseContainer):
    # uses cone.filenode
    # children as directories</code></pre>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">addables</div>
    <div class="card-body">
      <p class="small">Defines which child types can be added.</p>
      <pre class="p-2 small"><code>@node_info(
    name='document_library',
    addables=['document_folder', 'document'])</code></pre>
    </div>
  </div>

</tal:view>
