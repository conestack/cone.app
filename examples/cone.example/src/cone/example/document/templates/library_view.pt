<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3 example-header example-header-documents">

    <div class="card-body">

      <h4 class="card-title">
        <i class="bi-collection me-2"></i>
        <span class="label label-primary"
              tal:content="model.metadata.title">
          Title
        </span>
      </h4>

      <tal:byline replace="structure tile('byline')" />

      <p class="card-text text-muted">
        Hierarchical document management with workflow states
        and permission-protected fields.
      </p>

      <div class="mt-2">
        <span class="badge example-badge-documents">Workflow</span>
        <span class="badge example-badge-documents">Folders</span>
        <span class="badge example-badge-documents">Protected Properties</span>
        <span class="badge example-badge-documents">Translation</span>
      </div>

    </div>

  </div>

</tal:view>
