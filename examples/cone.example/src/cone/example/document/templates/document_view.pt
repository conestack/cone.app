<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3">
    <div class="card-header">
      <h4 class="card-title mb-0">
        <i class="bi-file-earmark-text me-2"></i>
        <span tal:content="model.metadata.title">Title</span>
      </h4>
    </div>
    <div class="card-body">
      <tal:byline replace="structure tile('byline')" />

      <p class="card-text text-muted"
         tal:content="model.metadata.description">
        Description
      </p>

      <hr />

      <div class="document-body"
           tal:define="body model.attrs.get('body', '')"
           tal:condition="body">
        <pre tal:content="body">Body content</pre>
      </div>

      <div class="text-muted"
           tal:condition="not:model.attrs.get('body', '')">
        <em>No content yet.</em>
      </div>
    </div>
  </div>

</tal:view>
