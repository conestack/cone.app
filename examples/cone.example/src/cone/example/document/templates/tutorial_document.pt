<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">Workflow</div>
    <div class="card-body">
      <p class="small">State machine with transitions and ACL per state.</p>
      <tal:code replace="structure context.example_workflow()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">ProtectedProperties</div>
    <div class="card-body">
      <p class="small">Property access controlled by permissions.</p>
      <tal:code replace="structure context.example_protected_properties()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">OwnerSupport</div>
    <div class="card-body">
      <p class="small">Tracks creator. Grants owner role automatically.</p>
      <tal:code replace="structure context.example_owner_support()" />
    </div>
  </div>

</tal:view>
