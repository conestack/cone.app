<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">Nested Containers</div>
    <div class="card-body">
      <p class="small">Folders can contain folders and documents recursively.</p>
      <tal:code replace="structure context.example_nested_containers()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">Properties</div>
    <div class="card-body">
      <p class="small">Control node behavior via properties.</p>
      <tal:code replace="structure context.example_properties()" />
    </div>
  </div>

</tal:view>
