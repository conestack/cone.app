<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3 example-header example-header-projects">

    <div class="card-body">

      <h4 class="card-title">
        <i class="bi-kanban me-2"></i>
        <span class="label label-primary"
              tal:content="model.metadata.title">
          Title
        </span>
      </h4>

      <tal:byline replace="structure tile('byline')" />

      <p class="card-text text-muted">
        Project and task management with advanced node patterns
        and batched listings.
      </p>

      <div class="mt-2">
        <span class="badge example-badge-projects">FactoryNode</span>
        <span class="badge example-badge-projects">AdapterNode</span>
        <span class="badge example-badge-projects">UUIDAsName</span>
        <span class="badge example-badge-projects">BatchedItems</span>
        <span class="badge example-badge-projects">Task Workflow</span>
      </div>

    </div>

  </div>

</tal:view>
