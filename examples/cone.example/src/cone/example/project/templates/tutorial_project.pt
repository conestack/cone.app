<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">NamespaceUUID</div>
    <div class="card-body">
      <p class="small">UUID calculated from node path + namespace. Deterministic.</p>
      <pre class="bg-light p-2 small"><code>@plumbing(NamespaceUUID, ...)
class Project:
    # uuid = uuid5(namespace, path)</code></pre>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">Categories</div>
    <div class="card-body">
      <p class="small">Categorization with i18n translation strings.</p>
      <pre class="bg-light p-2 small"><code>categories = [
    _('cat_development', default='Development'),
    _('cat_design', default='Design')
]</code></pre>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">PrincipalACL</div>
    <div class="card-body">
      <p class="small">Per-node role assignments. Enables sharing UI.</p>
      <pre class="bg-light p-2 small"><code>@plumbing(PrincipalACL, ...)
class Project:
    role_inheritance = True
    default_acl = [...]</code></pre>
    </div>
  </div>

</tal:view>
