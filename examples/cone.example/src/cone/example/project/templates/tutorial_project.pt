<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">NamespaceUUID</div>
    <div class="card-body">
      <p class="small">UUID calculated from node path + namespace. Deterministic.</p>
      <tal:code replace="structure context.example_namespace_uuid()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">Categories</div>
    <div class="card-body">
      <p class="small">Categorization with i18n translation strings.</p>
      <tal:code replace="structure context.example_categories()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">PrincipalACL</div>
    <div class="card-body">
      <p class="small">Per-node role assignments. Enables sharing UI.</p>
      <tal:code replace="structure context.example_principal_acl()" />
    </div>
  </div>

</tal:view>
