<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
           omit-tag="True">

  <tal:contextmenu replace="structure tile('contextmenu')" />

  <div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="card-title mb-0">
        <i class="bi-check2-square me-2"></i>
        <span tal:content="model.metadata.title">Title</span>
      </h4>
      <span class="badge bg-secondary"
            tal:content="getattr(model, 'state', 'N/A')">
        state
      </span>
    </div>
    <div class="card-body">
      <tal:byline replace="structure tile('byline')" />

      <p class="card-text"
         tal:content="model.metadata.description">
        Description
      </p>

      <dl class="row mt-3">
        <dt class="col-sm-3">UUID</dt>
        <dd class="col-sm-9"
            tal:content="str(getattr(model, 'uuid', 'N/A'))">uuid</dd>
        <dt class="col-sm-3">Path</dt>
        <dd class="col-sm-9"
            tal:content="'/'.join([_ for _ in model.path if _ is not None])">path</dd>
      </dl>
    </div>
  </div>

</tal:view>
