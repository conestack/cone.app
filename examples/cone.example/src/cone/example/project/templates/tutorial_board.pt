<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">FactoryNode</div>
    <div class="card-body">
      <p class="small">Lazily creates children from a factories dict. Children are volatile.</p>
      <tal:code replace="structure context.example_factory_node()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">BatchedItems</div>
    <div class="card-body">
      <p class="small">Paginated listings with search. Override slice_items and item_count.</p>
      <tal:code replace="structure context.example_batched_items()" />
    </div>
  </div>

</tal:view>
