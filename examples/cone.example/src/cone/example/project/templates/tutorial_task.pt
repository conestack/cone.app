<tal:view xmlns:tal="http://xml.zope.org/namespaces/tal"
          omit-tag="True">

  <div class="card mt-3">
    <div class="card-header">AdapterNode</div>
    <div class="card-body">
      <p class="small">Wraps a data node, proxying attributes. Separates storage from UI.</p>
      <tal:code replace="structure context.example_adapter_node()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">UUIDAsName</div>
    <div class="card-body">
      <p class="small">Node's __name__ is its UUID string.</p>
      <tal:code replace="structure context.example_uuid_as_name()" />
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">WorkflowState</div>
    <div class="card-body">
      <p class="small">State machine. State stored in attrs['state'].</p>
      <tal:code replace="structure context.example_workflow_state()" />
    </div>
  </div>

</tal:view>
