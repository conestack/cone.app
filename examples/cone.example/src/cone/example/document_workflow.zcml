<configure xmlns="http://namespaces.repoze.org/bfg"
           xmlns:i18n="http://xml.zope.org/namespaces/i18n"
           i18n:domain="cone.example">

  <include package="repoze.workflow" file="meta.zcml"/>

  <workflow type="document_workflow"
            name="Document Workflow"
            state_attr="state"
            initial_state="draft"
            content_types=".document.model.Document"
            permission_checker="cone.app.workflow.permission_checker">

    <state name="draft"
           title="Draft"
           i18n:attributes="name">
      <key name="description"
           value="Document is in draft state"
           i18n:attributes="value" />
    </state>

    <state name="review"
           title="In Review"
           i18n:attributes="name">
      <key name="description"
           value="Document is under review"
           i18n:attributes="value" />
    </state>

    <state name="published"
           title="Published"
           i18n:attributes="name">
      <key name="description"
           value="Document is published and visible"
           i18n:attributes="value" />
    </state>

    <state name="archived"
           title="Archived"
           i18n:attributes="name">
      <key name="description"
           value="Document is archived"
           i18n:attributes="value" />
    </state>

    <transition
       name="submit"
       title="Submit for Review"
       callback="cone.app.workflow.persist_state"
       from_state="draft"
       to_state="review"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="publish"
       title="Publish"
       callback="cone.app.workflow.persist_state"
       from_state="review"
       to_state="published"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="reject"
       title="Reject"
       callback="cone.app.workflow.persist_state"
       from_state="review"
       to_state="draft"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="archive"
       title="Archive"
       callback="cone.app.workflow.persist_state"
       from_state="published"
       to_state="archived"
       permission="change_state"
       i18n:attributes="name"
    />

    <transition
       name="retract"
       title="Retract"
       callback="cone.app.workflow.persist_state"
       from_state="published"
       to_state="draft"
       permission="change_state"
       i18n:attributes="name"
    />

  </workflow>

</configure>
